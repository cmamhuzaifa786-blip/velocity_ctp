#!/usr/bin/env bash
# Velocity CTP pre-commit check: blocks the commit if ruff finds lint or formatting problems.
# Install once per clone:  git config core.hooksPath .githooks
set -uo pipefail

RUFF_VERSION="0.14.10"
if command -v uvx >/dev/null 2>&1; then
	RUFF=(uvx "ruff@${RUFF_VERSION}")
elif command -v ruff >/dev/null 2>&1; then
	RUFF=(ruff)
else
	echo "pre-commit: ruff is not available. Install uv (https://docs.astral.sh/uv/) or ruff ${RUFF_VERSION}." >&2
	exit 1
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

status=0
echo "pre-commit: ruff check velocity_ctp"
"${RUFF[@]}" check velocity_ctp || status=1
echo "pre-commit: ruff format --check velocity_ctp"
"${RUFF[@]}" format --check velocity_ctp || status=1

if [ "$status" -ne 0 ]; then
	echo "" >&2
	echo "pre-commit: commit blocked. Fix the problems above (for example: ${RUFF[*]} check --fix velocity_ctp && ${RUFF[*]} format velocity_ctp) and commit again." >&2
fi
exit "$status"

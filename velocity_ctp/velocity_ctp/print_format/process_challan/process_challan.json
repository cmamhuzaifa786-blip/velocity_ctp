 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n\t.vt-doc { font-family: Inter, \"Helvetica Neue\", Arial, sans-serif; color: #111; font-size: 9.5pt; }\n\t.vt-doc h1 { font-size: 15pt; margin: 0 0 1mm; }\n\t.vt-doc .vt-sub { color: #555; margin-bottom: 4mm; }\n\t.vt-doc .vt-head { display: flex; justify-content: space-between; gap: 8mm; margin-bottom: 4mm; }\n\t.vt-doc .vt-box { border: 1px solid #bbb; border-radius: 2mm; padding: 2.5mm 3.5mm; flex: 1; }\n\t.vt-doc .vt-box div { display: grid; grid-template-columns: 30mm 1fr; gap: 2mm; margin: 0.6mm 0; }\n\t.vt-doc .vt-box b { color: #444; font-weight: 600; }\n\t.vt-doc table { width: 100%; border-collapse: collapse; margin-top: 2mm; }\n\t.vt-doc th, .vt-doc td { border: 1px solid #bbb; padding: 1.6mm 2mm; text-align: left; vertical-align: top; }\n\t.vt-doc th { background: #f0f0f0; font-weight: 600; color: #222 !important; }\n\t.vt-doc .nowrap { white-space: nowrap; }\n\t.vt-doc .num { text-align: right; white-space: nowrap; }\n\t.vt-doc tfoot td { font-weight: 700; background: #f7f7f7; }\n\t.vt-doc .vt-bundles { font-family: \"DejaVu Sans Mono\", monospace; font-size: 8pt; color: #333; }\n\t.vt-doc .vt-signs { display: flex; gap: 10mm; margin-top: 16mm; }\n\t.vt-doc .vt-signs div { flex: 1; border-top: 1px solid #333; padding-top: 1.5mm; text-align: center; color: #333; }\n\t.vt-doc h2 { font-size: 11pt; margin: 6mm 0 1mm; }\n\t@page { size: A4; margin: 12mm; }\n</style>\n{%- set lines = get_challan_lines(doc.name) -%}\n{%- set company = frappe.db.get_value(\"Company\", doc.company, \"company_name\") -%}\n<div class=\"vt-doc\">\n\t<h1>{{ company | e }}</h1>\n\t<div class=\"vt-sub\">{{ _(\"Process Challan\") }} \u2014 {{ doc.production_process | e }}{% if doc.party %} ({{ _(\"outsourced\") }}){% endif %}</div>\n\t<div class=\"vt-head\">\n\t\t<div class=\"vt-box\">\n\t\t\t<div><b>{{ _(\"Challan No.\") }}</b>{{ doc.name | e }}</div>\n\t\t\t<div><b>{{ _(\"Date\") }}</b>{{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}</div>\n\t\t\t<div><b>{{ _(\"Process\") }}</b>{{ doc.production_process | e }}</div>\n\t\t</div>\n\t\t<div class=\"vt-box\">\n\t\t\t<div><b>{{ _(\"Party\") }}</b>{{ (doc.party or _(\"In-house\")) | e }}</div>\n\t\t\t<div><b>{{ _(\"Vehicle No.\") }}</b>{{ (doc.vehicle_no or \"\u2014\") | e }}</div>\n\t\t\t<div><b>{{ _(\"Driver\") }}</b>{{ (doc.driver_name or \"\u2014\") | e }}</div>\n\t\t</div>\n\t</div>\n\t<table>\n\t\t<thead><tr>\n\t\t\t<th style=\"width:6%\">#</th><th>{{ _(\"Garment Order\") }}</th><th>{{ _(\"Style\") }}</th><th>{{ _(\"Colour\") }}</th>\n\t\t\t<th>{{ _(\"Size\") }}</th><th>{{ _(\"Bundles\") }}</th><th class=\"num\">{{ _(\"Qty\") }}</th>\n\t\t</tr></thead>\n\t\t<tbody>\n\t\t{%- for line in lines %}\n\t\t\t<tr>\n\t\t\t\t<td>{{ loop.index }}</td><td>{{ line.garment_order | e }}</td><td class=\"nowrap\">{{ line.style | e }}</td><td>{{ line.colour | e }}</td>\n\t\t\t\t<td>{{ line.size | e }}</td>\n\t\t\t\t<td><span class=\"vt-bundles\">{% for b in line.bundles %}<span class=\"nowrap\">{{ b | e }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span><br>{{ line.bundles | length }} {{ _(\"bundles\") }}</td>\n\t\t\t\t<td class=\"num\">{{ line.qty }}</td>\n\t\t\t</tr>\n\t\t{%- endfor %}\n\t\t</tbody>\n\t\t<tfoot><tr>\n\t\t\t<td colspan=\"5\">{{ _(\"Total\") }}</td><td>{{ doc.total_bundles }} {{ _(\"bundles\") }}</td><td class=\"num\">{{ doc.total_qty }}</td>\n\t\t</tr></tfoot>\n\t</table>\n\t{%- if doc.remarks %}<p style=\"margin-top:3mm\"><b>{{ _(\"Remarks\") }}:</b> {{ doc.remarks | e }}</p>{% endif %}\n\t<div class=\"vt-signs\"><div>{{ _(\"Prepared By\") }}</div><div>{{ _(\"Checked By\") }}</div><div>{{ _(\"Received By\") }}</div></div>\n</div>\n",
 "idx": 0,
